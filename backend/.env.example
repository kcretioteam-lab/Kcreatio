# Kcreatio — Backend Environment Variables
# Copy this file to .env and fill in all values before running

# ─── JWT Secrets (generate with: openssl rand -hex 32) ─────────────────────────
JWT_ACCESS_SECRET=your_access_secret_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_min_32_chars_different_from_access

# ─── Supabase ────────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ─── Razorpay (use test keys in development, live keys in production) ───────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ─── AI (Groq) ───────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key

# ─── Email (Resend) ──────────────────────────────────────────────────────────────
# Setup: https://resend.com → Domains → Add domain → Copy DNS records → Verify
# Then: API Keys → Create → copy key
RESEND_API_KEY=re_xxxxxxxxxxxx
FROM_EMAIL=noreply@kcreatio.in   # Must be from your verified Resend domain

# ─── Google OAuth (Login + Gmail Connect) ────────────────────────────────────────
# Setup steps:
#   1. Go to console.cloud.google.com → Select/Create project
#   2. APIs & Services → OAuth consent screen → External → fill app name + domain
#   3. APIs & Services → Library → Search "Gmail API" → Enable
#   4. Credentials → Create → OAuth 2.0 Client ID → Web application
#   5. Add Authorized redirect URIs:
#      - http://localhost:4000/api/v1/auth/google/callback (dev)
#      - https://your-domain.com/api/v1/auth/google/callback (prod)
#   6. Copy Client ID and Client Secret below
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# ─── Feature Flags ────────────────────────────────────────────────────────────────
# Gmail stays in "Testing" mode (max 100 test users) until Google app verification.
# Add test user emails in Google Cloud Console → OAuth consent screen → Test users.
GMAIL_TESTING_MODE=true
# Set to true only after Facebook/Instagram App Review approved (Phase 2)
META_OAUTH_ENABLED=false
# Enable background cron jobs (auto-enables in production)
ENABLE_JOBS=false

# ─── Phase 2 (not needed now — placeholder for future) ──────────────────────────
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# INSTAGRAM_CLIENT_ID=
# INSTAGRAM_CLIENT_SECRET=
# TWITTER_CLIENT_ID=
# TWITTER_CLIENT_SECRET=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=

# ─── App ─────────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
PORT=4000
