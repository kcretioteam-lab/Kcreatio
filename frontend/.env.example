# Kcreatio — Frontend Environment Variables
# Copy to .env.local in frontend/

VITE_API_URL=http://localhost:4000/api/v1

# Razorpay publishable key ID (safe to expose). Use rzp_test_* in dev, rzp_live_* in prod.
# The key SECRET and webhook secret stay backend-only — never put them here.
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
